{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emipac/skills/blob/main/skills/framework-setup/references/agent-framework.schema.json",
  "title": "AI Skills Framework configuration",
  "oneOf": [
    { "$ref": "#/$defs/schemaV3" },
    { "$ref": "#/$defs/schemaV4" }
  ],
  "$defs": {
    "schemaV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "backend",
        "frontend",
        "tracker",
        "artifacts",
        "guidelines",
        "source_scopes",
        "verification",
        "history",
        "protected_files"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "backend": { "enum": ["laravel", "express-typescript", "unknown"] },
        "frontend": { "$ref": "#/$defs/frontendProfile" },
        "tracker": { "$ref": "#/$defs/tracker" },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "guidelines": { "$ref": "#/$defs/uniqueStrings" },
        "source_scopes": { "$ref": "#/$defs/sourceScopes" },
        "verification": { "$ref": "#/$defs/verificationV3" },
        "history": { "$ref": "#/$defs/history" },
        "protected_files": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "schemaV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "backend",
        "frontend",
        "tracker",
        "artifacts",
        "guidelines",
        "source_scopes",
        "verification",
        "history",
        "protected_files"
      ],
      "properties": {
        "schema_version": { "const": 4 },
        "backend": { "$ref": "#/$defs/backendProfileV4" },
        "frontend": { "$ref": "#/$defs/frontendProfile" },
        "tracker": { "$ref": "#/$defs/tracker" },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "guidelines": { "$ref": "#/$defs/uniqueStrings" },
        "source_scopes": { "$ref": "#/$defs/sourceScopes" },
        "verification": { "$ref": "#/$defs/verificationV4" },
        "evaluation_gate": { "$ref": "#/$defs/evaluationGate" },
        "history": { "$ref": "#/$defs/history" },
        "protected_files": { "$ref": "#/$defs/uniqueStrings" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "backend": { "const": "none" } },
            "required": ["backend"]
          },
          "then": {
            "properties": {
              "source_scopes": {
                "properties": { "backend": { "maxItems": 0 } }
              },
              "verification": {
                "properties": {
                  "commands": {
                    "additionalProperties": {
                      "properties": { "backend": { "maxItems": 0 } }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "frontend": { "const": "none" } },
            "required": ["frontend"]
          },
          "then": {
            "properties": {
              "source_scopes": {
                "properties": { "frontend": { "maxItems": 0 } }
              },
              "verification": {
                "properties": {
                  "commands": {
                    "additionalProperties": {
                      "properties": { "frontend": { "maxItems": 0 } }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "backendProfileV4": {
      "enum": ["laravel", "express-typescript", "none", "unknown"]
    },
    "frontendProfile": {
      "enum": [
        "livewire",
        "react-typescript",
        "svelte-typescript",
        "none",
        "unknown"
      ]
    },
    "tracker": {
      "enum": ["local-markdown", "github", "jira", "linear"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["srs", "glossary", "adrs"],
      "properties": {
        "srs": { "type": ["string", "null"] },
        "glossary": { "type": ["string", "null"] },
        "adrs": { "type": ["string", "null"] }
      }
    },
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sourceScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "shared"],
      "properties": {
        "backend": { "$ref": "#/$defs/uniqueStrings" },
        "frontend": { "$ref": "#/$defs/uniqueStrings" },
        "shared": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "verificationV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "capabilities", "commands"],
      "properties": {
        "profile": { "type": "string" },
        "capabilities": { "$ref": "#/$defs/uniqueStrings" },
        "commands": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/rawCommandScopes" }
        }
      }
    },
    "verificationV4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "capabilities", "commands"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/uniqueStrings" },
        "commands": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/descriptorCommandScopes" }
        }
      }
    },
    "rawCommandScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "both"],
      "properties": {
        "backend": { "$ref": "#/$defs/uniqueStrings" },
        "frontend": { "$ref": "#/$defs/uniqueStrings" },
        "both": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "descriptorCommandScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "both"],
      "properties": {
        "backend": {
          "type": "array",
          "items": { "$ref": "#/$defs/backendCommandDescriptor" }
        },
        "frontend": {
          "type": "array",
          "items": { "$ref": "#/$defs/frontendCommandDescriptor" }
        },
        "both": {
          "type": "array",
          "items": { "$ref": "#/$defs/bothCommandDescriptor" }
        }
      }
    },
    "commandDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "args",
        "working_directory",
        "timeout_seconds",
        "allowed_environment",
        "evidence_category",
        "source_scope"
      ],
      "properties": {
        "runner": {
          "enum": ["composer-bin", "php-script", "package-script", "repository-script"]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "working_directory": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "allowed_environment": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        },
        "evidence_category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "source_scope": { "enum": ["backend", "frontend", "both"] }
      }
    },
    "backendCommandDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/commandDescriptor" },
        { "properties": { "source_scope": { "const": "backend" } } }
      ]
    },
    "frontendCommandDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/commandDescriptor" },
        { "properties": { "source_scope": { "const": "frontend" } } }
      ]
    },
    "bothCommandDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/commandDescriptor" },
        { "properties": { "source_scope": { "const": "both" } } }
      ]
    },
    "evaluationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "budget", "bypass", "execution", "evidence"],
      "properties": {
        "checks": { "$ref": "#/$defs/gateChecks" },
        "budget": { "$ref": "#/$defs/gateBudget" },
        "bypass": { "$ref": "#/$defs/gatePolicySubcontract" },
        "execution": { "$ref": "#/$defs/gatePolicySubcontract" },
        "evidence": { "$ref": "#/$defs/gatePolicySubcontract" }
      }
    },
    "gateChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "advisory"],
      "properties": {
        "required": { "$ref": "#/$defs/uniqueStrings" },
        "advisory": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "gateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_seconds"],
      "properties": {
        "total_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "gatePolicySubcontract": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "activation",
            "activated",
            "allowed_environment",
            "args",
            "capabilities",
            "client",
            "command",
            "commands",
            "evidence_category",
            "executable",
            "hook",
            "profile",
            "profiles",
            "receipt",
            "runner",
            "source_scope",
            "trust",
            "version",
            "working_directory"
          ]
        }
      },
      "additionalProperties": { "$ref": "#/$defs/gatePolicyValue" }
    },
    "gatePolicyValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/gatePolicyValue" }
        },
        { "$ref": "#/$defs/gatePolicySubcontract" }
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
